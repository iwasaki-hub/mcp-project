# Server-only Vercel environment variables. Never prefix these with VITE_.
# Use a dedicated read-only Atlas user; do not reuse the existing readWrite test user.
MONGODB_URI=mongodb+srv://<read-only-user>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Generate a long random value and store it only in Vercel's protected environment variables.
ATLAS_HEALTHCHECK_TOKEN=<random-secret>
